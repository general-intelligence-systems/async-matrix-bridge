#!/usr/bin/env bash
# Run the suite against a homeserver brought up for it.
#
# The homeserver is recreated rather than reused: its database is in tmpfs, so a fresh container has
# no appservice state. A transaction which failed once puts the scheduler into a backoff reaching 512
# seconds, and an example started afterwards would be waiting on that rather than on itself.
set -e

root="$(cd "$(dirname "$0")/.." && pwd)"
compose="docker compose --file $root/synapse/docker-compose.yml"

$compose up -d --force-recreate --wait

CONSOLE_LEVEL=${CONSOLE_LEVEL:-info} bundle exec sus "$@"
